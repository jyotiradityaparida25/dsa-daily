class Solution:
    def distinctEchoSubstrings(self, text: str) -> int:
        n = len(text)
        seen = set()
        
        base = 31
        mod = 10**9 + 7
        
        pow_base = [1] * (n + 1)
        prefix_hash = [0] * (n + 1)
        
        for i in range(n):
            pow_base[i + 1] = (pow_base[i] * base) % mod
            prefix_hash[i + 1] = (prefix_hash[i] * base + (ord(text[i]) - ord('a') + 1)) % mod
            
        def get_hash(l: int, r: int) -> int:
            return (prefix_hash[r + 1] - prefix_hash[l] * pow_base[r - l + 1]) % mod

        for length in range(1, n // 2 + 1):
            for i in range(n - 2 * length + 1):
                hash1 = get_hash(i, i + length - 1)
                hash2 = get_hash(i + length, i + 2 * length - 1)
                
                if hash1 == hash2:
                    full_hash = get_hash(i, i + 2 * length - 1)
                    seen.add(full_hash)

        return len(seen)
